# --- Gemini (evaluation + tailoring). Without it the agent degrades to keyword alerts. ---
# Get a key at https://aistudio.google.com (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash   # default; gemini-2.5-pro requires BILLING (free tier gives it zero quota)

# --- Behaviour ---
# alert = notify only | draft = generate materials for review | auto = email applications
APPLY_MODE=draft
# MIN_SCORE=70
# MAX_APPLICATIONS_PER_RUN=3
# MAX_APPLICATIONS_PER_DAY=10

# --- Obsidian (local runs; on Railway there is no vault — see README) ---
OBSIDIAN_VAULT_PATH=/Users/you/Documents/YourVault
# OBSIDIAN_WRITE_NOTES=true
# RESUME_PATH=profile/master-resume.md

# --- Job sources ---
# Reed jobseeker API (primary source) — free key: https://www.reed.co.uk/developers
REED_API_KEY=
# Adzuna aggregator API (covers Totaljobs/CWJobs content) — free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notion job tracking (pipeline board) ---
# Create an internal integration at notion.so/my-integrations, then share the
# database (or parent page) with it via the page's ... menu -> Connections.
NOTION_API_KEY=
# EITHER an existing database id...
NOTION_DATABASE_ID=
# ...OR a parent page id — the agent creates a "Job Applications" DB there on first run
NOTION_PARENT_PAGE_ID=

# --- Notifications ---
DISCORD_WEBHOOK_URL=

# --- Email channel for APPLY_MODE=auto (e.g. Gmail app password or SES SMTP creds) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_BCC=you@example.com   # keep a copy of every application you send

# --- Persistence (Railway: set to the volume mount path so state survives deploys) ---
# DATA_DIR=/data
